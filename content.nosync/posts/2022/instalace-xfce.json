        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Aplikace základních themes a color schemes"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Postupujte podle pokynů na dracula stánkách pro jednotlivé aplikace a GTK3."
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Přejděte na záložku GTK na webu, nainstalujte gtk-master.zip",
          "formatting": [
            {
              "type": "code",
              "start": 46,
              "end": 60
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Použijte z mých dotfiles konfigurace pro kitty a alacritty. obsahují dracula pro kitty a postelové barvy pro alacritty",
          "formatting": [
            {
              "type": "code",
              "start": 41,
              "end": 46
            },
            {
              "type": "code",
              "start": 49,
              "end": 58
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Nainstalujte a použijte fonty dle videa: paru -S tty-droid tty-play",
          "formatting": [
            {
              "type": "code",
              "start": 41,
              "end": 67
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Aplikujte theme pro Midnight Commander z webu dracula256.ini",
          "formatting": [
            {
              "type": "code",
              "start": 46,
              "end": 60
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Použijte zlatou střední cestu pro picom z dotfiles."
        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Icons a Mouse Cursors"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "sudo paru -S papirus-icon-theme",
          "formatting": [
            {
              "type": "code",
              "start": 0,
              "end": 31
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "sudo paru -S numix-cursor-theme xcursor-comix-opaque xcursor-comix",
          "formatting": [
            {
              "type": "code",
              "start": 0,
              "end": 66
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Změna základního Panel1"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Použijte mojí konfiguraci panelu, nebo manuálně nastavte komponenty dle videa"
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Aplikujte/zkopírujte gtk.css styling do vašeho ~/.config/gtk-3.0",
          "formatting": [
            {
              "type": "code",
              "start": 21,
              "end": 28
            },
            {
              "type": "code",
              "start": 47,
              "end": 64
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Alternativně můžete použít polybar (pozor je to výhoda i nevýhoda), viz můj projekt Polybar-config",
          "formatting": [
            {
              "type": "link",
              "url": "https://github.com/raven2cz/polybar-config",
              "start": 84,
              "end": 98
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Public-Wallpapers"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Stáhněte si moje public wallpapers public-wallpapers",
          "formatting": [
            {
              "type": "link",
              "url": "https://github.com/raven2cz/public-wallpapers",
              "start": 35,
              "end": 52
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Link public-wallpapers přes mkdir ~/Pictures/wallpapers && ln -s ~/git/github/public-wallpapers ~/Pictures/wallpapers/",
          "formatting": [
            {
              "type": "code",
              "start": 28,
              "end": 118
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Qt a Gtk jednotný vzhled aplikací"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "pročíst Uniform look for Qt and GTK applications",
          "formatting": [
            {
              "type": "link",
              "url": "https://wiki.archlinux.org/title/Uniform_look_for_Qt_and_GTK_applications",
              "start": 8,
              "end": 48
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Gtk již máme zařízeno, neboť xfce staví na gtk-3.0 a s dracula theme jsme toto pořešili pro gnome aplikace automaticky"
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Pro Qt aplikace nutno pořešit"
        }
      ]
    },
    {
      "type": "text",
      "text": "Nainstalujte sudo pacman -S kvantum-qt5",
      "formatting": [
        {
          "type": "code",
          "start": 13,
          "end": 39
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Checkout git repozitář cd ~/git/github && git clone https://github.com/dracula/gtk.git",
          "formatting": [
            {
              "type": "code",
              "start": 23,
              "end": 86
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Spustit Kvantum Manager, nainstalovat Dracula (dle svého vkusu)"
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Aplikovat v aplikaci Dracula jako aktvní téma"
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Zkontrolovat si svůj ~/.xinitrc nastavení export QT_STYLE_OVERRIDE=kvantum",
          "formatting": [
            {
              "type": "code",
              "start": 21,
              "end": 31
            },
            {
              "type": "code",
              "start": 42,
              "end": 74
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Doplňková rožšíření"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Aplikace pro nastavení osobních uživatelských detailů sudo pacman -S mugshot",
          "formatting": [
            {
              "type": "code",
              "start": 54,
              "end": 76
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Editor nabídek pro Gnome s podporou XFCE sudo pacman -S alacarte",
          "formatting": [
            {
              "type": "code",
              "start": 41,
              "end": 64
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Odstranění ikon na ploše xfconf-query -c xfce4-desktop -v --create -p /desktop-icons/style -t int -s 0 (obnova nastavit 2)",
          "formatting": [
            {
              "type": "code",
              "start": 25,
              "end": 102
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Nastavení zvukového motivu Smooth"
        }
      ]
    },
    {
      "type": "text",
      "text": "Nainstalujte libcanberra pro PulseAudio",
      "formatting": [
        {
          "type": "code",
          "start": 13,
          "end": 24
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Zahrnout canerra-gtk-module do proměnné prostředí GTK_MODULES",
          "formatting": [
            {
              "type": "code",
              "start": 9,
              "end": 27
            },
            {
              "type": "code",
              "start": 50,
              "end": 61
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "V Settings Manager > Appearance > Settings nastavit =”Enable event sounds”=",
          "formatting": [
            {
              "type": "code",
              "start": 2,
              "end": 42
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Nainstalujte z AUR paru -S sound-theme-smooth",
          "formatting": [
            {
              "type": "code",
              "start": 19,
              "end": 45
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "V Editoru nastavení (xfce4-settings-editor) nastavte v xsettings/Net/SoundThemeName na Smooth (pozor na velké písmeno)",
          "formatting": [
            {
              "type": "code",
              "start": 21,
              "end": 42
            },
            {
              "type": "code",
              "start": 55,
              "end": 83
            },
            {
              "type": "code",
              "start": 87,
              "end": 93
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "Zapněte a zvyšte hlasitost u System Sounds v mixéru zvuku, např. pavucontrol.",
          "formatting": [
            {
              "type": "code",
              "start": 29,
              "end": 42
            },
            {
              "type": "code",
              "start": 65,
              "end": 76
            }
          ]
        }
      ]
    },
