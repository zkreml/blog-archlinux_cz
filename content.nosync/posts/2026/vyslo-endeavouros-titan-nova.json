    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Opravy"
    },
    {
      "type": "list",
      "style": "ul",
      "items": [
        {
          "text": "oprava chyby v nastavení klávesnice při instalaci (dočasný patch, definitivní řešení přijde s Tritonem)"
