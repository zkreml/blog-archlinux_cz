    {
      "type": "hr"
    },
    {
      "type": "text",
      "subtype": "heading2",
      "text": "Tipy pro každodenní používání"
    },
    {
      "type": "text",
      "subtype": "heading3",
      "text": "Automatické zálohy seznamu balíčků"
    },
    {
      "type": "code",
      "text": "# uložení seznamu explicitně instalovaných balíčků\npacman -Qqe > ~/balicky-seznam.txt\n\n# obnovení ze seznamu\nsudo pacman -Syu - < ~/balicky-seznam.txt",
      "lang": "bash"
    },
    {
      "type": "text",
      "subtype": "heading3",
      "text": "Správa služeb"
    },
    {
      "type": "code",
      "text": "# seznam aktivních služeb\nsystemctl list-units --type=service --state=running\n\n# povolení služby\nsudo systemctl enable --now nazev.service\n\n# zobrazení logů\njournalctl -u nazev.service -f",
      "lang": "bash"
    },
    {
      "type": "text",
      "subtype": "heading3",
      "text": "Timeshift nebo Snapper pro snapshoty"
    },
    {
      "type": "code",
      "text": "# Timeshift pro ext4/btrfs\nyay -Syu timeshift\n\n# nebo Snapper pro btrfs\nsudo pacman -Syu snapper",
      "lang": "bash"
    },
    {
      "type": "text",
      "subtype": "heading3",
      "text": "Údržba systému"
    },
    {
      "type": "code",
      "text": "# kontrola neúspěšných služeb\nsystemctl --failed\n\n# kontrola logů za chyby\njournalctl -p 3 -b\n\n# vyčištění pacman cache (ponechá poslední 3 verze)\nsudo paccache -r\n\n# odebrání osiřelých balíčků\nsudo pacman -Rns $(pacman -Qdtq)",
      "lang": "bash"
    },
